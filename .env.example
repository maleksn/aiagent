# OpenRouter API Key
# Obtain your key from OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Preferred OpenRouter model (default: google/gemini-2.5-flash)
# Examples: google/gemini-2.5-flash, anthropic/claude-3.5-sonnet, openai/gpt-4o-mini
OPENROUTER_MODEL=google/gemini-2.5-flash

# Fallback: GEMINI_API_KEY is also accepted
# GEMINI_API_KEY=your_api_key_here
